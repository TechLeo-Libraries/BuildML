        "fired_rule_ids",
        "chosen_rule_id",
        "neural_prediction",
        "repaired"
      ]
    },
    "default_symbolic_backend_when_installed": "industry",
    "default_industry_method_when_installed": "rulefit",
    "default_neuro_backend_when_installed": "sklearn",
    "install_hints": {
      "symbolic-industry": "pip install 'buildml[symbolic-industry]'  # skope-rules + imodels + optional Z3 constraint checks",
      "torch": "pip install 'buildml[torch]'  # concept-bottleneck / neural-additive neuro-symbolic bases"
    },
    "non_goals": [
