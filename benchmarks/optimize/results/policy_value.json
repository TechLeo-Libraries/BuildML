        "methods": [
          "threshold"
        ],
        "solvers": {
          "threshold": "XGBClassifier scale_pos_weight + validation sweep"
        },
        "notes": "Cost-sensitive gradient-boosted classifier trained on train; threshold tuned on validation expected cost."
      }
    },
    "allocation_vs_threshold": {
